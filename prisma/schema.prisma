generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id               Int      @id @default(autoincrement())
  enterprise       String
  state            String
  bidStatus        String
  subsidiesOwedSum BigInt
  sendDate         DateTime
  subsidiesName    String   @default("")
}
